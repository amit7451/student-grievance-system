# ==============================================================================
# Backend Development Dockerfile with Live Reload (nodemon)
# ==============================================================================
FROM node:20-alpine

WORKDIR /app

# Copy dependency definitions
COPY package*.json ./

# Install all dependencies including devDependencies (nodemon)
RUN npm install

# Copy application source
COPY . .

# Environment defaults
ENV NODE_ENV=development
ENV PORT=5000

# Expose API port
EXPOSE 5000

# Health check probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:' + (process.env.PORT || 5000) + '/', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) }).on('error', () => process.exit(1))"

# Start server using nodemon for automatic reloads on code change
CMD ["npm", "run", "dev"]
