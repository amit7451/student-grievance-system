# ==============================================================================
# Environment Configuration for Docker Compose
# Copy this file to .env before running docker compose:
#   cp .env.docker.example .env
# ==============================================================================

# --- Host Port Mappings ---
FRONTEND_PORT=5173
BACKEND_PORT=5000
MONGO_PORT=27017

# --- Backend Configuration ---
PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_12345
CLIENT_URL=http://localhost:5173

# --- Database Connection ---
# Option 1: Local containerized MongoDB (Default, no setup needed)
MONGO_URI=mongodb://mongo:27017/grievance_db

# Option 2: MongoDB Atlas (Uncomment and fill in if using remote Atlas cluster)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/grievance_db?retryWrites=true&w=majority

# --- Frontend API Endpoint ---
# Used during frontend build. Leave as http://localhost:5000 for direct calls
# or empty string ("") to route through Nginx reverse proxy
VITE_API_URL=http://localhost:5000
